{
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "01-core@01tech-plugins": false,
    "01-frontend@01tech-plugins": false,
    "01-platform@01tech-plugins": false,
    "01-dev-pipeline@01tech-plugins": false,
    "01-utils@01tech-plugins": false,
    "01-qa-assist@01tech-plugins": false,
    "qa-core@betting-qa": false,
    "qa-testing@betting-qa": false,
    "requirements-quality@betting-qa": false,
    "qa-databases@betting-qa": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push*--force*)",
      "Bash(git push -f*)",
      "Bash(git commit*--no-verify*)"
    ],
    "ask": [
      "Edit(./.specify/memory/constitution.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/guard-constitution.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/docs-lint.py\" --hook" }
        ]
      }
    ]
  }
}
